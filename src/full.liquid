<div class="layout layout--col gap--small">

  <div class="grid grid--cols-12 gap portrait:grid--cols-1 portrait:gap--small">
    <div class="col--span-5 flex flex--col gap--small portrait:col--span-1">
      <span class="label label--filled no-shrink">LAST RIDE</span>
      {% if has_most_recent %}
        <div class="flex flex--col gap--xsmall">
          <span class="title title--small">{{ most_recent.name | truncate: 28 }}</span>
          <span class="label label--small label--gray">{{ most_recent_date_label }}</span>
        </div>
        <span class="value value--large value--tnums">{{ most_recent.distance }}</span>

        <div class="divider"></div>

        <div class="flex flex--col gap--xsmall w--full">
          <div class="item">
            <div class="icon"><img class="image--adaptive w--[6cqw] h--[6cqh]" src="data:image/svg+xml;base64,{{ icon_time }}"></div>
            <div class="content flex flex--row flex--center-y gap--small w--full">
              <span class="label label--small grow">Time</span>
              <span class="value value--small value--tnums">{{ most_recent.movingTime }}</span>
            </div>
          </div>
          <div class="item">
            <div class="icon"><img class="image--adaptive w--[6cqw] h--[6cqh]" src="data:image/svg+xml;base64,{{ icon_elevation }}"></div>
            <div class="content flex flex--row flex--center-y gap--small w--full">
              <span class="label label--small grow">Elev Gain</span>
              <span class="value value--small value--tnums">{{ most_recent.elevationGain }}</span>
            </div>
          </div>
          <div class="item">
            <div class="icon"><img class="image--adaptive w--[6cqw] h--[6cqh]" src="data:image/svg+xml;base64,{{ icon_speed }}"></div>
            <div class="content flex flex--row flex--center-y gap--small w--full">
              <span class="label label--small grow">Avg Speed</span>
              <span class="value value--small value--tnums">{% if most_recent.averageSpeed %}{{ most_recent.averageSpeed }}{% else %}—{% endif %}</span>
            </div>
          </div>
        </div>
      {% else %}
        {{ no_rides_empty_state }}
      {% endif %}
    </div>

    <div class="col--span-7 flex flex--col gap--small portrait:col--span-1">
      <span class="label label--filled no-shrink">THIS WEEK · {{ week_range }}</span>
      <div class="flex flex--col gap--small w--full grow" style="justify-content: center;">
        {% assign day_distances = weekly.days | map: "distanceValue" | sort %}
        {% assign max_distance = day_distances | last %}
        {% for day in weekly.days %}
          <div class="flex flex--row flex--center-y gap--small w--full">
            <span class="label label--small {% unless day.hasRide %}text--gray-25{% endunless %}" style="width: 34px;">{{ day.dayLabel | upcase }}</span>
            <div style="position: relative; flex: 1 1 auto; height: 20px;">
              <div style="position: absolute; left: 0; right: 0; top: 9px; height: 2px; background-image: repeating-linear-gradient(to right, #ccc 0 3px, transparent 3px 6px);"></div>
              {% if day.hasRide and max_distance > 0 %}
                {% assign bar_pct = day.distanceValue | times: 100.0 | divided_by: max_distance %}
                <div style="position: absolute; left: 0; top: 2px; height: 16px; width: {{ bar_pct | round: 1 }}%; background: #000; border-radius: 2px;"></div>
              {% endif %}
            </div>
            <span class="label label--small {% unless day.hasRide %}text--gray-25{% endunless %}" style="width: 60px; text-align: right;">{% if day.hasRide %}{{ day.distance }}{% else %}—{% endif %}</span>
          </div>
        {% endfor %}
      </div>
      <span class="value value--xsmall value--tnums">{{ weekly.rideCount }} ride{% if weekly.rideCount != 1 %}s{% endif %} · {{ weekly.distance }} · {{ weekly.movingTime }} · {{ weekly.elevationGain }} gain</span>
    </div>
  </div>

</div>

{{ title_bar }}
